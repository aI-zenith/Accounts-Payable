<%
  const v = (x) => (x === null || x === undefined ? '' : x);
  const items = Array.isArray(data.line_items) ? data.line_items : [];
  const pillClass = (s) => ({
    pending: 'pill--pending', extracting: 'pill--extracting', extracted: 'pill--extracted',
    confirmed: 'pill--confirmed', needs_review: 'pill--review', pushed: 'pill--pushed', error: 'pill--error',
  }[s] || 'pill--pending');
%>

<section class="review-head">
  <div>
    <a class="backlink" href="/">← All invoices</a>
    <h1 class="page-title"><%= invoice.original_name %></h1>
  </div>
  <span class="pill <%= pillClass(invoice.status) %>"><%= invoice.status.replace(/_/g, ' ') %></span>
</section>

<% if (invoice.status === 'error') { %>
  <div class="banner banner--error">
    <strong>Extraction failed.</strong>
    <span><%= invoice.error_msg || 'Unknown error.' %></span>
  </div>
<% } else if (invoice.status === 'extracting' || invoice.status === 'pending') { %>
  <div class="banner banner--info" data-poll="1">
    <strong>Extracting…</strong>
    <span>Claude is reading this invoice. This page will refresh automatically.</span>
  </div>
<% } %>

<form class="review" action="/invoice/<%= invoice.id %>/confirm" method="post">
  <div class="review__grid">
    <div class="review__pdf">
      <iframe class="pdfframe" src="/file/<%= invoice.id %>" title="Invoice PDF"></iframe>
    </div>

    <div class="review__form ledger-rule">
      <div class="fieldrow">
        <label class="field">
          <span class="field__label">Vendor name</span>
          <input class="input" type="text" name="vendor_name" value="<%= v(data.vendor_name) %>" />
        </label>
        <label class="field">
          <span class="field__label">Invoice number</span>
          <input class="input" type="text" name="invoice_number" value="<%= v(data.invoice_number) %>" />
        </label>
      </div>

      <div class="fieldrow">
        <label class="field">
          <span class="field__label">Invoice date</span>
          <input class="input" type="date" name="invoice_date" value="<%= v(data.invoice_date) %>" />
        </label>
        <label class="field">
          <span class="field__label">Due date</span>
          <input class="input" type="date" name="due_date" value="<%= v(data.due_date) %>" />
        </label>
      </div>

      <div class="fieldrow">
        <label class="field">
          <span class="field__label">Property / job</span>
          <input class="input" type="text" name="property_reference" value="<%= v(data.property_reference) %>" />
        </label>
        <label class="field">
          <span class="field__label">Credit card</span>
          <input class="input" type="text" name="credit_card" value="<%= v(data.credit_card) %>" placeholder="e.g. wood ave" />
        </label>
        <label class="field field--narrow">
          <span class="field__label">Card last 4</span>
          <input class="input num" type="text" name="card_last4" value="<%= v(data.card_last4) %>" maxlength="4" placeholder="6760" />
        </label>
        <label class="field field--narrow">
          <span class="field__label">Currency</span>
          <input class="input" type="text" name="currency" value="<%= v(data.currency) %>" maxlength="8" />
        </label>
      </div>

      <fieldset class="lineitems">
        <legend>Line items</legend>
        <table class="mini" id="lineItems">
          <thead>
            <tr>
              <th>Description</th>
              <th class="num">Qty</th>
              <th class="num">Unit price</th>
              <th class="num">Amount</th>
              <th aria-label="Remove"></th>
            </tr>
          </thead>
          <tbody>
            <% (items.length ? items : [{}]).forEach((li) => { %>
              <tr class="li-row">
                <td><input class="input input--bare" type="text" name="li_description" value="<%= v(li.description) %>" /></td>
                <td class="num"><input class="input input--bare num" type="text" name="li_qty" value="<%= v(li.qty) %>" /></td>
                <td class="num"><input class="input input--bare num" type="text" name="li_unit_price" value="<%= v(li.unit_price) %>" /></td>
                <td class="num"><input class="input input--bare num" type="text" name="li_amount" value="<%= v(li.amount) %>" /></td>
                <td class="num"><button type="button" class="iconbtn" data-remove-row aria-label="Remove line">×</button></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <button type="button" class="linkbtn" id="addRow">+ Add line item</button>
      </fieldset>

      <div class="fieldrow fieldrow--totals">
        <label class="field field--narrow">
          <span class="field__label">Subtotal</span>
          <input class="input num" type="text" name="subtotal" value="<%= v(data.subtotal) %>" />
        </label>
        <label class="field field--narrow">
          <span class="field__label">Tax</span>
          <input class="input num" type="text" name="tax" value="<%= v(data.tax) %>" />
        </label>
        <label class="field field--narrow">
          <span class="field__label">Total</span>
          <input class="input num input--strong" type="text" name="total" value="<%= v(data.total) %>" />
        </label>
      </div>
    </div>
  </div>

  <div class="actionbar">
    <div class="actionbar__meta">
      <% if (invoice.rm_project_id) { %>
        RM record <code><%= invoice.rm_project_id %></code>
      <% } %>
    </div>
    <div class="actionbar__buttons">
      <button type="submit" class="btn btn--primary">Save changes</button>
      <button type="submit" class="btn btn--ghost" formaction="/invoice/<%= invoice.id %>/push" formnovalidate>
        Push to Rent Manager
      </button>
    </div>
  </div>
</form>

<!-- Hidden template row used by app.js when adding a line item. -->
<template id="liTemplate">
  <tr class="li-row">
    <td><input class="input input--bare" type="text" name="li_description" value="" /></td>
    <td class="num"><input class="input input--bare num" type="text" name="li_qty" value="" /></td>
    <td class="num"><input class="input input--bare num" type="text" name="li_unit_price" value="" /></td>
    <td class="num"><input class="input input--bare num" type="text" name="li_amount" value="" /></td>
    <td class="num"><button type="button" class="iconbtn" data-remove-row aria-label="Remove line">×</button></td>
  </tr>
</template>
