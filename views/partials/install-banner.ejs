<div class="installbar" id="installBar" hidden>
  <img class="installbar__icon" src="/img/icon-192.png" alt="" width="44" height="44" />
  <div class="installbar__txt">
    <strong>Install Zenith</strong>
    <span data-install-note>Add it to your home screen for quick, full-screen access.</span>
  </div>
  <div class="installbar__actions">
    <button type="button" class="installbar__install" data-install-app>Install</button>
    <button type="button" class="installbar__dismiss" data-install-dismiss>Don’t show again</button>
  </div>
  <button type="button" class="installbar__x" data-install-close aria-label="Dismiss">×</button>
</div>
