<%
  const apActive = ['dashboard', 'reconcile'].includes(active);
  const homeActive = active === 'home';
  const tasksActive = active === 'tasks';
  const ic = {
    home: '<path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>',
    task: '<path d="M5 5h14v14H5z" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M8.5 12l2.2 2.2L16 9" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
    ap: '<path d="M4 4h16v4H4zM4 11h16M4 16h10" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>',
    prop: '<path d="M4 10l8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>',
    res: '<circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M5 19c1-3.5 4-5 7-5s6 1.5 7 5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>',
    lease: '<path d="M6 3h9l4 4v14H6z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/><path d="M9 12h6M9 16h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
    maint: '<path d="M14 6a4 4 0 0 0-5 5l-5 5 2 2 5-5a4 4 0 0 0 5-5l-2 2-2-2z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>',
    report: '<path d="M5 19V9M12 19V4M19 19v-7" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/>',
    team: '<circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M3.5 19c.8-2.8 3-4 5.5-4s4.7 1.2 5.5 4M16 7.2a3 3 0 0 1 0 5.6M17.5 19c-.3-1.6-1-2.8-2-3.6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>',
    cog: '<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M18.5 5.5l-1.4 1.4M6.9 17.1l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  };
  const initial = (currentUser.name || currentUser.email || '?').trim().slice(0, 1).toUpperCase();
%>
<aside class="sidebar">
  <a class="sidebar__brand" href="/">
    <img class="sidebar__logo" src="/img/zenith-mark.svg" alt="" />
    <span class="sidebar__brandtext">
      <span class="sidebar__company">Zenith</span>
      <span class="sidebar__tag">Group · Operations</span>
    </span>
  </a>

  <nav class="sidebar__nav" aria-label="Primary">
    <div class="navgroup">
      <a class="navlink <%= homeActive ? 'is-active' : '' %>" href="/">
        <svg class="navlink__icon" viewBox="0 0 24 24"><%- ic.home %></svg>
        Dashboard
      </a>
    </div>

    <div class="navgroup">
      <div class="navgroup__label">Modules</div>

      <% if (can('tasks')) { %>
      <a class="navlink <%= tasksActive ? 'is-active' : '' %>" href="/tasks">
        <svg class="navlink__icon" viewBox="0 0 24 24"><%- ic.task %></svg>
        Tasks
      </a>
      <% if (tasksActive) { %>
        <div class="navsub">
          <a class="navsub__link <%= taskActive === 'list' ? 'is-active' : '' %>" href="/tasks">All tasks</a>
          <a class="navsub__link <%= taskActive === 'board' ? 'is-active' : '' %>" href="/tasks/board">Board</a>
          <a class="navsub__link <%= taskActive === 'snoozed' ? 'is-active' : '' %>" href="/tasks/snoozed">Snoozed</a>
          <a class="navsub__link <%= taskActive === 'reminders' ? 'is-active' : '' %>" href="/reminders">My Reminders</a>
        </div>
      <% } %>
      <% } %>

      <% if (can('accounts_payable')) { %>
      <a class="navlink <%= apActive ? 'is-active' : '' %>" href="/invoices">
        <svg class="navlink__icon" viewBox="0 0 24 24"><%- ic.ap %></svg>
        Accounts Payable
      </a>
      <% if (apActive) { %>
        <div class="navsub">
          <a class="navsub__link <%= active === 'dashboard' ? 'is-active' : '' %>" href="/invoices">Invoices</a>
          <a class="navsub__link <%= active === 'reconcile' ? 'is-active' : '' %>" href="/reconcile">Reconcile</a>
        </div>
      <% } %>
      <% } %>

      <span class="navlink navlink--soon"><svg class="navlink__icon" viewBox="0 0 24 24"><%- ic.prop %></svg>Properties <span class="navlink__soon">soon</span></span>
      <span class="navlink navlink--soon"><svg class="navlink__icon" viewBox="0 0 24 24"><%- ic.res %></svg>Residents <span class="navlink__soon">soon</span></span>
      <span class="navlink navlink--soon"><svg class="navlink__icon" viewBox="0 0 24 24"><%- ic.lease %></svg>Leasing <span class="navlink__soon">soon</span></span>
      <span class="navlink navlink--soon"><svg class="navlink__icon" viewBox="0 0 24 24"><%- ic.maint %></svg>Maintenance <span class="navlink__soon">soon</span></span>
      <span class="navlink navlink--soon"><svg class="navlink__icon" viewBox="0 0 24 24"><%- ic.report %></svg>Reports <span class="navlink__soon">soon</span></span>
    </div>

    <% if (can('team') || can('settings')) { %>
    <div class="navgroup">
      <div class="navgroup__label">Workspace</div>
      <% if (can('team')) { %>
      <a class="navlink <%= active === 'team' ? 'is-active' : '' %>" href="/team">
        <svg class="navlink__icon" viewBox="0 0 24 24"><%- ic.team %></svg>
        Team
      </a>
      <% } %>
      <% if (can('settings')) { %>
      <a class="navlink <%= active === 'settings' ? 'is-active' : '' %>" href="/settings">
        <svg class="navlink__icon" viewBox="0 0 24 24"><%- ic.cog %></svg>
        Settings
      </a>
      <% if (active === 'settings') { %>
        <div class="navsub">
          <a class="navsub__link is-active" href="/settings/accounts-payable">Accounts Payable</a>
        </div>
      <% } %>
      <% } %>
    </div>
    <% } %>
  </nav>

  <div class="sidebar__foot">
    <div class="avatar avatar--accent"><%= initial %></div>
    <div class="usermini">
      <div class="usermini__name"><%= currentUser.name || currentUser.email %></div>
      <div class="usermini__role"><%= currentUser.roleName %></div>
    </div>
    <form method="post" action="/logout">
      <button class="logoutbtn" type="submit" title="Sign out" aria-label="Sign out">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3M10 12H3m0 0 3-3m-3 3 3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </form>
  </div>
</aside>
