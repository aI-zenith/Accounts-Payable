<%
  const PRIO = { urgent: 'Urgent', high: 'High', medium: 'Medium', low: 'Low' };
  const STAT = { open: 'Open', in_progress: 'In Progress', blocked: 'Blocked', in_review: 'In Review', done: 'Done' };
  const initials = (n) => { const p = String(n || '?').trim().split(/\s+/); return ((p[0][0] || '?') + (p[1] ? p[1][0] : '')).toUpperCase(); };
  const AVC = ['#2b5fd9', '#7a4dd1', '#0f9d8f', '#c2611f', '#c0398a', '#3a7a3a', '#b5791a', '#d6453d'];
  const avc = (n) => { let h = 0; for (const ch of String(n || '')) h = (h * 31 + ch.charCodeAt(0)) >>> 0; return AVC[h % AVC.length]; };
  const fmtD = (d) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric' }) : '';
  const dueInfo = (t) => { if (!t.due_at) return { label: '—', cls: 'tdue-gray', plain: true }; const ms = new Date(t.due_at) - Date.now(); const day = 86400000; if (t.status !== 'done' && ms < 0) return { label: 'Overdue', cls: 'tdue-red' }; if (t.status !== 'done' && ms < day) return { label: 'Today', cls: 'tdue-red' }; if (t.status !== 'done' && ms < 3 * day) return { label: fmtD(t.due_at), cls: 'tdue-amber' }; return { label: fmtD(t.due_at), cls: 'tdue-gray' }; };
  // Active chip = open-only filter with no specific status selected.
  const statusChip = filters.openOnly && !filters.status ? 'active' : filters.status;
  const rowUrl = (id) => '/tasks/table?' + (qs ? qs + '&' : '') + 'sel=' + id + '&tab=conversation';
  const SORTS = { due_at: 'Due date', priority: 'Priority', status: 'Status', title: 'Title', created_at: 'Created', updated_at: 'Updated' };
%>

<div class="tk">
  <form id="tableFilters" method="get" action="/tasks/table">
    <% ['dir'].forEach((k) => { %><input type="hidden" name="<%= k %>" value="<%= filters[k] %>" /><% }) %>

    <div class="tk-top">
      <div>
        <h1 class="tk-title">Tasks</h1>
        <div class="tk-subtitle">All tasks</div>
      </div>
      <div class="tk-search">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5l3 3"/></svg>
        <input name="q" value="<%= filters.q %>" placeholder="Search tasks, properties, people…" />
        <kbd>/</kbd>
      </div>
      <div style="flex:1"></div>
      <div class="tk-views">
        <span class="tk-views__lbl">View</span>
        <a class="on" href="/tasks/table">Table</a>
        <a href="/tasks/board">Board</a>
        <a href="/tasks">Inbox</a>
      </div>
      <a class="btnp" href="/tasks/new"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg>New task</a>
    </div>

    <div class="tk-filters">
      <label class="tk-fchip">
        <span class="tk-fchip__k">Status</span>
        <select name="status" data-autosubmit>
          <option value="active" <%= statusChip === 'active' ? 'selected' : '' %>>Active</option>
          <option value="" <%= statusChip === '' ? 'selected' : '' %>>Any</option>
          <% Object.entries(STAT).forEach(([k, v]) => { %><option value="<%= k %>" <%= filters.status === k ? 'selected' : '' %>><%= v %></option><% }) %>
        </select>
      </label>
      <label class="tk-fchip">
        <span class="tk-fchip__k">Assignee</span>
        <select name="assignee" data-autosubmit>
          <option value="">Anyone</option>
          <% users.forEach((u) => { %><option value="<%= u.id %>" <%= String(filters.assignee) === String(u.id) ? 'selected' : '' %>><%= u.name || u.email %></option><% }) %>
        </select>
      </label>
      <label class="tk-fchip">
        <span class="tk-fchip__k">Property</span>
        <select name="category" data-autosubmit>
          <option value="">All</option>
          <% categories.forEach((c) => { %><option value="<%= c.name %>" <%= filters.category === c.name ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </label>
      <label class="tk-fchip">
        <span class="tk-fchip__k">Priority</span>
        <select name="priority" data-autosubmit>
          <option value="">Any</option>
          <% Object.entries(PRIO).forEach(([k, v]) => { %><option value="<%= k %>" <%= filters.priority === k ? 'selected' : '' %>><%= v %></option><% }) %>
        </select>
      </label>
      <label class="tk-fchip tk-fchip--ghost">
        <input type="checkbox" name="hasTenant" value="1" <%= filters.hasTenant ? 'checked' : '' %> data-autosubmit hidden />
        <span class="tk-fadd"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg> Add filter</span>
      </label>

      <div style="flex:1"></div>
      <div class="tk-count"><strong><%= tasks.length %></strong> task<%= tasks.length === 1 ? '' : 's' %><% if (overdue) { %> · <span style="color:#c0392b"><%= overdue %> overdue</span><% } %></div>
      <label class="tk-fchip">
        <span class="tk-fchip__k">Sort</span>
        <select name="sort" data-autosubmit>
          <% Object.entries(SORTS).forEach(([k, v]) => { %><option value="<%= k %>" <%= filters.sort === k ? 'selected' : '' %>><%= v %></option><% }) %>
        </select>
      </label>
    </div>
  </form>

  <% if (!tasks.length) { %>
    <div class="tktable-empty">
      <p class="tktable-empty__t">No tasks match these filters</p>
      <p class="tktable-empty__s">Create one with “New task”, or clear the filters above.</p>
    </div>
  <% } else { %>
    <div class="tktable">
      <div class="tktable__head tktable__row">
        <div></div>
        <div>Task</div>
        <div>Status</div>
        <div>Priority</div>
        <div>Property · Linked</div>
        <div>Assignee</div>
        <div>Due</div>
      </div>
      <% tasks.forEach((t) => { const du = dueInfo(t); const on = task && task.id === t.id; const a = t.assignees[0]; %>
        <a class="tktable__row tktable__tr <%= on ? 'on' : '' %>" href="<%= rowUrl(t.id) %>">
          <div class="tktable__chk"><span class="tktable__sq" style="background:<%= ({ urgent: '#c0392b', high: '#c2611f', medium: '#2b5fd9', low: '#8a909c' })[t.priority] %>"></span></div>
          <div class="tktable__task">
            <div class="tktable__title"><%= t.title %></div>
            <div class="tktable__sub">
              <span class="mono tktable__id">TSK-<%= 1000 + t.id %></span>
              <% if (t.category) { %><span class="tktable__cat"><%= t.category %></span><% } %>
              <% if (t.sub_total) { %><span class="tktable__m"><svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8.5l3 3 6-7" stroke-linecap="round" stroke-linejoin="round"/></svg><%= t.sub_done %>/<%= t.sub_total %></span><% } %>
              <% if (t.comment_count) { %><span class="tktable__m"><svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 4.5h11v6h-6l-3 2.5V10.5h-2z" stroke-linejoin="round"/></svg><%= t.comment_count %></span><% } %>
              <% if (t.attach_count) { %><span class="tktable__m"><svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 7.5l-5.5 5.5a3 3 0 0 1-4.2-4.2L8.5 3a2 2 0 0 1 2.8 2.8L6 11" stroke-linecap="round" stroke-linejoin="round"/></svg><%= t.attach_count %></span><% } %>
            </div>
          </div>
          <div><span class="tps tps-<%= t.status %>"><%= STAT[t.status] %></span></div>
          <div><span class="tpr tpr-<%= t.priority %>"><%= PRIO[t.priority] %></span></div>
          <div class="tktable__linked">
            <div><%= t.category || '—' %></div>
            <% if (t.link_name) { %><div class="tktable__link2"><%= t.link_type %> · <%= t.link_name %></div><% } %>
          </div>
          <div class="tktable__assignee">
            <% if (a) { %><span class="av" style="width:24px;height:24px;background:<%= avc(a.name) %>;font-size:9.5px"><%= initials(a.name) %></span><span class="tktable__aname"><%= a.name %><% if (t.assignees.length > 1) { %> +<%= t.assignees.length - 1 %><% } %></span><% } else { %><span class="tktable__unassigned">Unassigned</span><% } %>
          </div>
          <div><% if (du.plain) { %><span class="tdue-plain">—</span><% } else { %><span class="tdue <%= du.cls %>"><%= du.label %></span><% } %></div>
        </a>
      <% }) %>
    </div>
  <% } %>

  <% if (task) { %>
    <a class="tk-scrim" href="/tasks/table<%= qs ? '?' + qs : '' %>" aria-label="Close"></a>
    <aside class="tk-drawer">
      <a class="tk-drawer__x" href="/tasks/table<%= qs ? '?' + qs : '' %>" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round"/></svg>
      </a>
      <%- include('../partials/task-detail', { task, tab, currentUser, backUrl: '/tasks/table?' + (qs ? qs + '&' : '') + 'sel=' + task.id }) %>
    </aside>
  <% } %>
</div>
