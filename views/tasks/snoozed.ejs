<%
  const PRIO = { urgent: 'Urgent', high: 'High', medium: 'Medium', low: 'Low' };
  const wakeWhen = (d) => { if (!d) return ''; const dt = new Date(d); return dt.toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }); };
%>

<section class="page-head">
  <h1 class="page-title">Snoozed tasks</h1>
  <p class="page-sub">These are hidden from every list and view until they wake up. Bring one back early with “Wake up now”.</p>
</section>

<%- include('../partials/task-nav') %>

<% if (!tasks.length) { %>
  <div class="empty"><p class="empty__title">Nothing snoozed</p><p class="empty__body">Snoozed tasks will appear here with their wake-up time.</p></div>
<% } else { %>
  <ul class="snoozelist">
    <% tasks.forEach((t)=>{ %>
      <li class="snoozeitem">
        <div class="snoozeitem__main">
          <a class="cell-primary" href="/tasks/<%= t.id %>"><%= t.title %></a>
          <div class="snoozeitem__meta">
            <span class="pill prio-<%= t.priority %>"><%= PRIO[t.priority] %></span>
            <% if (t.category) { %><span class="hint"><%= t.category %></span><% } %>
            <span class="hint">Wakes <strong><%= wakeWhen(t.snoozed_until) %></strong></span>
          </div>
        </div>
        <form method="post" action="/tasks/<%= t.id %>/wake">
          <input type="hidden" name="back" value="/tasks/snoozed" />
          <button class="btn btn--ghost btn--sm" type="submit">Wake up now</button>
        </form>
      </li>
    <% }) %>
  </ul>
<% } %>
