<%
  const STAT = { open: 'Open', in_progress: 'In Progress', blocked: 'Blocked', in_review: 'In Review', done: 'Done' };
  const PRIO = { urgent: 'Urgent', high: 'High', medium: 'Medium', low: 'Low' };
  const PRC = { urgent: '#c0392b', high: '#c2611f', medium: '#2b5fd9', low: '#8a909c' };
  const STC = { open: '#8a909c', in_progress: '#2b5fd9', blocked: '#c0392b', in_review: '#9a6b12', done: '#2f9e6e' };
  const initials = (n) => { const p = String(n || '?').trim().split(/\s+/); return ((p[0][0] || '?') + (p[1] ? p[1][0] : '')).toUpperCase(); };
  const AVC = ['#2b5fd9', '#7a4dd1', '#0f9d8f', '#c2611f', '#c0398a', '#3a7a3a', '#b5791a', '#d6453d'];
  const avc = (n) => { let h = 0; for (const ch of String(n || '')) h = (h * 31 + ch.charCodeAt(0)) >>> 0; return AVC[h % AVC.length]; };
  const fmtD = (d) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric' }) : '';
  const dueInfo = (t) => { if (!t.due_at) return null; const ms = new Date(t.due_at) - Date.now(); const day = 86400000; if (t.status !== 'done' && ms < 0) return { label: 'Overdue', cls: 'tdue-red' }; if (t.status !== 'done' && ms < day) return { label: 'Today', cls: 'tdue-red' }; if (t.status !== 'done' && ms < 3 * day) return { label: fmtD(t.due_at), cls: 'tdue-amber' }; return { label: fmtD(t.due_at), cls: 'tdue-gray' }; };
%>

<div class="tk">
  <div class="tk-top">
    <h1 class="tk-title">Tasks</h1>
    <div class="tk-views">
      <a href="/tasks/table">Table</a>
      <a class="on" href="/tasks/board">Board</a>
      <a href="/tasks">Inbox</a>
    </div>
    <div style="flex:1"></div>
    <a class="btnp" href="/tasks/new"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg>New task</a>
  </div>

  <div class="tkb">
    <% columns.forEach((col) => { %>
      <div class="tkb-col" data-status="<%= col.key %>">
        <div class="tkb-colhd">
          <span class="tkb-dot" style="background:<%= STC[col.key] %>"></span>
          <span class="tkb-colname"><%= STAT[col.key] %></span>
          <span class="tkb-count"><%= col.tasks.length %></span>
          <div style="flex:1"></div>
          <a class="tkb-plus" href="/tasks/new" title="New task">+</a>
        </div>
        <div class="tkb-list" data-droplist>
          <% col.tasks.forEach((t) => { const du = dueInfo(t); const a = t.assignees[0]; %>
            <a class="tkb-card" style="border-left-color:<%= PRC[t.priority] %>" href="/tasks/board?sel=<%= t.id %>&tab=overview" draggable="true" data-task-id="<%= t.id %>">
              <div class="tkb-card__top">
                <% if (t.category) { %><span class="tktable__cat"><%= t.category %></span><% } %>
                <div style="flex:1"></div>
                <span class="tpr tpr-<%= t.priority %>"><%= PRIO[t.priority] %></span>
              </div>
              <div class="tkb-card__title"><%= t.title %></div>
              <div class="tkb-card__sub">
                <span class="mono" style="font-size:10.5px;color:#8a909c">TSK-<%= 1000 + t.id %></span>
                <% if (t.link_name) { %><span style="color:#5b6472"><%= t.link_type %> · <%= t.link_name %></span><% } %>
              </div>
              <div class="tkb-card__foot">
                <% if (du) { %><span class="tdue <%= du.cls %>"><%= du.label %></span><% } %>
                <% if (t.sub_total) { %><span class="tktable__m"><svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8.5l3 3 6-7" stroke-linecap="round" stroke-linejoin="round"/></svg><%= t.sub_done %>/<%= t.sub_total %></span><% } %>
                <% if (t.comment_count) { %><span class="tktable__m"><svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 4.5h11v6h-6l-3 2.5V10.5h-2z" stroke-linejoin="round"/></svg><%= t.comment_count %></span><% } %>
                <div style="flex:1"></div>
                <% if (a) { %><span class="av" style="width:23px;height:23px;background:<%= avc(a.name) %>;font-size:9.5px"><%= initials(a.name) %></span><% } %>
              </div>
            </a>
          <% }) %>
          <a class="tkb-newcard" href="/tasks/new">+ New task</a>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (task) { %>
    <a class="tk-scrim" href="/tasks/board" aria-label="Close"></a>
    <div class="tk-modal" data-detail-pane>
      <a class="tk-drawer__x" href="/tasks/board" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round"/></svg>
      </a>
      <%- include('../partials/task-detail', { task, tab, currentUser, backUrl: '/tasks/board?sel=' + task.id }) %>
    </div>
  <% } %>
</div>
