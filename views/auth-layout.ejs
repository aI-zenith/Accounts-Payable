<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== 'undefined' ? title + ' · ' + brand.company : brand.company %></title>
    <link rel="icon" href="/img/zenith-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="authpage">
    <section class="authpage__panel">
      <div class="authpanel__brand">
        <img class="authpanel__logo" src="/img/zenith-mark.svg" alt="" />
        <div>
          <div class="authpanel__name">Zenith Group</div>
          <div class="authpanel__tag">Operations Platform</div>
        </div>
      </div>
      <div class="authpanel__copy">
        <h2>Run the whole portfolio from one place.</h2>
        <p>Accounts payable today — leasing, residents, maintenance and reporting next.</p>
      </div>
      <div class="authpanel__foot">© <%= year %> Zenith Group</div>
    </section>
    <main class="authpage__form">
      <%- body %>
    </main>
    <script src="/js/app.js" defer></script>
  </body>
</html>
