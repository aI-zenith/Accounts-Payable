<section class="page-head">
  <h1 class="page-title">Settings</h1>
  <p class="page-sub">Credentials are encrypted at rest. Leave a field blank to keep the stored value.</p>
</section>

<form class="settings" action="/settings" method="post">
  <!-- Rent Manager -->
  <section class="card ledger-rule" data-integration="rentmanager">
    <header class="card__head">
      <div class="card__title">
        <span class="dot" data-dot aria-hidden="true"></span>
        <h2>Rent Manager</h2>
      </div>
      <button type="button" class="btn btn--ghost btn--sm" data-test="rentmanager">Test connection</button>
    </header>
    <p class="card__status" data-status hidden></p>

    <div class="fieldrow">
      <label class="field">
        <span class="field__label">Subdomain or base URL</span>
        <input class="input" type="text" name="rm_subdomain" value="<%= settings.rm_subdomain %>"
               placeholder="bluegm" autocomplete="off" />
        <span class="field__hint">Just the subdomain (<code>bluegm</code>) or the full URL (<code>https://bluegm.api.rentmanager.com</code>)</span>
      </label>
    </div>
    <div class="fieldrow">
      <label class="field">
        <span class="field__label">Username</span>
        <input class="input" type="text" name="rm_username" autocomplete="off"
               placeholder="<%= settings.has_rm_username ? settings.rm_username_masked : 'Not set' %>" />
      </label>
      <label class="field">
        <span class="field__label">Password</span>
        <input class="input" type="password" name="rm_password" autocomplete="new-password"
               placeholder="<%= settings.has_rm_password ? settings.rm_password_masked : 'Not set' %>" />
      </label>
    </div>
  </section>

  <!-- Claude API -->
  <section class="card ledger-rule" data-integration="claude">
    <header class="card__head">
      <div class="card__title">
        <span class="dot" data-dot aria-hidden="true"></span>
        <h2>Claude API</h2>
      </div>
      <button type="button" class="btn btn--ghost btn--sm" data-test="claude">Test connection</button>
    </header>
    <p class="card__status" data-status hidden></p>

    <div class="fieldrow">
      <label class="field">
        <span class="field__label">API key</span>
        <input class="input" type="password" name="anthropic_api_key" autocomplete="new-password"
               placeholder="<%= settings.has_anthropic ? settings.anthropic_masked : 'Not set' %>" />
        <span class="field__hint">Used for invoice extraction. Falls back to <code>ANTHROPIC_API_KEY</code> if unset.</span>
      </label>
    </div>
  </section>

  <!-- Email inbox (IMAP) -->
  <section class="card ledger-rule" data-integration="email">
    <header class="card__head">
      <div class="card__title">
        <span class="dot" data-dot aria-hidden="true"></span>
        <h2>Email inbox</h2>
      </div>
      <button type="button" class="btn btn--ghost btn--sm" data-test="email">Test connection</button>
    </header>
    <p class="card__status" data-status hidden></p>
    <p class="card__intro">Bills emailed to this mailbox are ingested automatically: each PDF attachment is extracted and pushed to Rent Manager as a credit card transaction. Use a dedicated inbox the bills are forwarded to.</p>

    <div class="fieldrow">
      <label class="field">
        <span class="field__label">IMAP host</span>
        <input class="input" type="text" name="imap_host" value="<%= settings.imap_host %>"
               placeholder="imap.gmail.com" autocomplete="off" />
        <span class="field__hint">e.g. <code>imap.gmail.com</code>, <code>outlook.office365.com</code></span>
      </label>
      <label class="field">
        <span class="field__label">Port</span>
        <input class="input" type="number" name="imap_port" value="<%= settings.imap_port %>"
               placeholder="993" autocomplete="off" />
        <span class="field__hint">993 = implicit TLS (recommended)</span>
      </label>
    </div>
    <div class="fieldrow">
      <label class="field">
        <span class="field__label">Username</span>
        <input class="input" type="text" name="imap_user" value="<%= settings.imap_user %>"
               placeholder="bills@yourdomain.com" autocomplete="off" />
      </label>
      <label class="field">
        <span class="field__label">Password</span>
        <input class="input" type="password" name="imap_password" autocomplete="new-password"
               placeholder="<%= settings.has_imap_password ? settings.imap_password_masked : 'Not set' %>" />
        <span class="field__hint">For Gmail/Office365 use an <strong>app password</strong>, not your login.</span>
      </label>
    </div>
    <div class="fieldrow">
      <label class="field">
        <span class="field__label">Mailbox / folder</span>
        <input class="input" type="text" name="imap_mailbox" value="<%= settings.imap_mailbox %>"
               placeholder="INBOX" autocomplete="off" />
      </label>
      <label class="field">
        <span class="field__label">Only accept from (optional)</span>
        <input class="input" type="text" name="imap_allowed_senders" value="<%= settings.imap_allowed_senders %>"
               placeholder="billing@vendor.com, ap@othervendor.com" autocomplete="off" />
        <span class="field__hint">Comma-separated allow-list. Blank = accept any sender.</span>
      </label>
    </div>
    <div class="fieldrow">
      <label class="field field--check">
        <input type="checkbox" name="email_auto_push" <%= settings.email_auto_push ? 'checked' : '' %> />
        <span class="field__label">Auto-push to Rent Manager</span>
        <span class="field__hint">On: emailed bills post automatically when the card, vendor and property all match (anything unmatched waits for review). Off: every emailed bill waits for review.</span>
      </label>
    </div>
  </section>

  <div class="settings__actions">
    <button type="submit" class="btn btn--primary">Save settings</button>
  </div>
</form>

<!-- Default expense (GL) account for the allocation line -->
<section class="card ledger-rule" style="margin-top: 22px;">
  <header class="card__head">
    <div class="card__title"><h2>Default expense account</h2></div>
  </header>
  <p class="field__hint" style="margin-bottom: 14px;">
    Rent Manager requires a GL account on each credit card transaction. Pushed
    transactions post to this account (you can re-categorize in RM later).
    <% if (settings.default_gl_account_name) { %>
      Currently: <code><%= settings.default_gl_account_name %></code>.
    <% } %>
  </p>
  <form action="/settings/default-gl" method="post" class="fieldrow" id="glForm">
    <label class="field">
      <span class="field__label">Expense account</span>
      <select class="input" name="default_gl_account_id" id="glSelect" required <%= glAccounts.length ? '' : 'disabled' %>>
        <option value="" disabled <%= settings.default_gl_account_id ? '' : 'selected' %>>Choose an account…</option>
        <% glAccounts.forEach((a) => { %>
          <option value="<%= a.id %>" data-name="<%= a.name %>" <%= String(settings.default_gl_account_id) === a.id ? 'selected' : '' %>><%= a.name %><%= a.ref ? ' (' + a.ref + ')' : '' %></option>
        <% }) %>
      </select>
      <input type="hidden" name="default_gl_account_name" id="glName" value="<%= settings.default_gl_account_name %>" />
    </label>
    <div class="field field--narrow" style="justify-content: flex-end;">
      <button type="submit" class="btn btn--ghost">Save account</button>
    </div>
  </form>
</section>

<!-- Credit card mappings (last-4 -> Rent Manager card) -->
<section class="card ledger-rule" style="margin-top: 22px;">
  <header class="card__head">
    <div class="card__title">
      <h2>Credit card mappings</h2>
    </div>
  </header>
  <p class="field__hint" style="margin-bottom: 14px;">
    Map a card's last 4 digits (from the receipt) to the matching Rent Manager card,
    e.g. <code>6760 → Chase …7202</code>.
  </p>

  <% if (rmCardsError) { %>
    <p class="card__status is-fail" style="display:block;">Couldn't load Rent Manager cards: <%= rmCardsError %></p>
  <% } %>

  <% if (cardMappings && cardMappings.length) { %>
    <table class="mini" style="margin-bottom: 16px;">
      <thead>
        <tr><th>Last 4</th><th>Rent Manager card</th><th aria-label="Remove"></th></tr>
      </thead>
      <tbody>
        <% cardMappings.forEach((m) => { %>
          <tr>
            <td><code>•••• <%= m.last4 %></code></td>
            <td><%= m.rm_card_name || m.rm_card_id %></td>
            <td class="num">
              <form action="/settings/card-mappings/<%= m.id %>/delete" method="post" onsubmit="return confirm('Remove this mapping?');">
                <button type="submit" class="iconbtn" aria-label="Remove">×</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="field__hint" style="margin-bottom: 14px;">No mappings yet.</p>
  <% } %>

  <form action="/settings/card-mappings" method="post" class="fieldrow" id="cardMapForm">
    <label class="field field--narrow">
      <span class="field__label">Last 4</span>
      <input class="input num" type="text" name="last4" maxlength="4" placeholder="6760" required />
    </label>
    <label class="field">
      <span class="field__label">Rent Manager card</span>
      <select class="input" name="rm_card_id" id="rmCardSelect" required <%= rmCards.length ? '' : 'disabled' %>>
        <option value="" disabled selected>Choose a card…</option>
        <% rmCards.forEach((c) => { %>
          <option value="<%= c.id %>" data-name="<%= c.name %>"><%= c.name %> (ID <%= c.id %>)</option>
        <% }) %>
      </select>
      <input type="hidden" name="rm_card_name" id="rmCardName" />
    </label>
    <div class="field field--narrow" style="justify-content: flex-end;">
      <button type="submit" class="btn btn--ghost">Add mapping</button>
    </div>
  </form>
</section>
