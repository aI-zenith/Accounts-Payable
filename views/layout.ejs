<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== 'undefined' ? title + ' · ' + brand.company : brand.company %></title>
    <link rel="icon" href="/img/zenith-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <body class="app">
    <div class="app">
      <%- include('partials/sidebar') %>
      <div class="app__main">
        <header class="appbar">
          <button class="appbar__toggle" id="navToggle" aria-label="Menu">☰</button>
          <div class="appbar__title"><%= typeof title !== 'undefined' ? title : '' %></div>
          <div class="appbar__spacer"></div>
          <span class="appbar__crumb"><%= brand.company %> · <%= brand.product %></span>
        </header>
        <main class="content">
          <%- include('partials/reminder-banner') %>
          <% if (typeof notice !== 'undefined' && notice) { %>
            <div class="notice" role="status"><%= notice %></div>
          <% } %>
          <%- body %>
        </main>
      </div>
    </div>
    <script src="/js/app.js" defer></script>
  </body>
  <% } else { %>
  <body class="app app--bare">
    <main class="content" style="max-width: 720px">
      <%- body %>
    </main>
    <script src="/js/app.js" defer></script>
  </body>
  <% } %>
</html>
