DATABASE_URL=postgresql://...sslmode=require
APP_ENCRYPTION_KEY=   # generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ANTHROPIC_API_KEY=    # fallback if not set in Settings

# Rent Manager API (company code: bluegm)
RENTMANAGER_BASE_URL=https://bluegm.api.rentmanager.com
RENTMANAGER_USERNAME=
RENTMANAGER_PASSWORD=
RENTMANAGER_LOCATION_ID=1

# Legacy fallbacks (still supported if the RENTMANAGER_* vars are unset)
RM_SUBDOMAIN=
RM_USERNAME=
RM_PASSWORD=

# Email intake (IMAP). Bills emailed here are ingested + pushed automatically.
# These are fallbacks; the same values can be set (and the password encrypted) in
# the Settings UI instead.
IMAP_HOST=            # e.g. imap.gmail.com, outlook.office365.com
IMAP_PORT=993
IMAP_USER=            # the mailbox address, e.g. bills@yourdomain.com
IMAP_PASSWORD=        # an app password for Gmail/Office365 (not the login password)
IMAP_MAILBOX=INBOX
IMAP_ALLOWED_SENDERS= # optional comma-separated allow-list; blank = accept any
EMAIL_AUTO_PUSH=true  # auto-post to Rent Manager (false = hold every bill for review)
EMAIL_POLL_INTERVAL_MS=60000

PORT=3000
NODE_ENV=development
